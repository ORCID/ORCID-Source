<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

    <changeSet id="CREATE-PROFILE-RECOVERY-PHONE-TABLE" author="Leonardo Mendoza">
        <createTable tableName="profile_recovery_phone">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true"
                             primaryKeyName="profile_recovery_phone_pkey"/>
            </column>
            <column name="orcid" type="VARCHAR(19)">
                <constraints nullable="false" />
            </column>
            <!-- Salted one way hash of the E.164 number. The plain number is never stored. -->
            <column name="hashed_phone_number" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <!-- Last four digits, the only part of the number ever displayed back to the user. -->
            <column name="last_four" type="VARCHAR(4)">
                <constraints nullable="false" />
            </column>
            <column name="date_created" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_modified" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addForeignKeyConstraint constraintName="profile_recovery_phone_orcid_fk" baseTableName="profile_recovery_phone"
                                 baseColumnNames="orcid" referencedTableName="profile" referencedColumnNames="orcid"/>
    </changeSet>

    <changeSet id="CREATE-PROFILE-RECOVERY-PHONE-SEQUENCES" author="Leonardo Mendoza">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="profile_recovery_phone_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="profile_recovery_phone_seq" startValue="100000"/>
    </changeSet>

    <changeSet id="CREATE-PROFILE-RECOVERY-PHONE-AUTOCOLS" author="Leonardo Mendoza" dbms="hsqldb">
        <addAutoIncrement tableName="profile_recovery_phone" columnName="id" columnDataType="bigint" startWith="100000"/>
    </changeSet>

    <changeSet id="PROFILE-RECOVERY-PHONE-ORCID-INDEX" author="Leonardo Mendoza">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="profile_recovery_phone_orcid_index" tableName="profile_recovery_phone" />
            </not>
        </preConditions>
        <sql>create unique index profile_recovery_phone_orcid_index on profile_recovery_phone(orcid);</sql>
    </changeSet>

    <changeSet id="GRANT-READ-PERMISSIONS-TO-ORCIDRO-ON-PROFILE-RECOVERY-PHONE" author="Leonardo Mendoza" dbms="postgresql">
        <preConditions>
            <sqlCheck expectedResult="1">SELECT 1 FROM pg_roles WHERE rolname='orcidro'</sqlCheck>
        </preConditions>
        <sql>GRANT SELECT ON profile_recovery_phone to orcidro;</sql>
    </changeSet>

</databaseChangeLog>
