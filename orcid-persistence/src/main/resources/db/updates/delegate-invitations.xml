<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

    <changeSet id="CREATE-DELEGATE-INVITATION-TABLE" author="Camelia Dumitru">
        <createTable tableName="delegate_invitation">
            <column name="delegate_invitation_id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="delegate_invitation_pkey"/>
            </column>
            <column name="date_created" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_modified" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="sender_orcid" type="VARCHAR(19)">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_orcid" type="VARCHAR(19)">
                <constraints nullable="false"/>
            </column>
            <column name="entered_email" type="VARCHAR(320)"/>
            <column name="status" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="actionable_notification_id" type="bigint"/>
            <column name="sender_notice_acknowledged" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="delegate_invitation_sender_fk" baseTableName="delegate_invitation"
                                 baseColumnNames="sender_orcid" referencedTableName="profile" referencedColumnNames="orcid"/>
        <addForeignKeyConstraint constraintName="delegate_invitation_recipient_fk" baseTableName="delegate_invitation"
                                 baseColumnNames="recipient_orcid" referencedTableName="profile" referencedColumnNames="orcid"/>
        <addForeignKeyConstraint constraintName="delegate_invitation_notification_fk" baseTableName="delegate_invitation"
                                 baseColumnNames="actionable_notification_id" referencedTableName="notification" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex tableName="delegate_invitation" indexName="delegate_invitation_sender_recipient_status_idx">
            <column name="sender_orcid"/>
            <column name="recipient_orcid"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="delegate_invitation" indexName="delegate_invitation_expiry_idx">
            <column name="status"/>
            <column name="date_created"/>
        </createIndex>
    </changeSet>

    <changeSet id="CREATE-DELEGATE-INVITATION-SEQUENCE" author="Camelia Dumitru" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="delegate_invitation_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="delegate_invitation_seq" startValue="100000"/>
    </changeSet>

    <changeSet id="CREATE-DELEGATE-INVITATION-AUTO-INCREMENT" author="Camelia Dumitru" dbms="hsqldb">
        <addAutoIncrement tableName="delegate_invitation" columnName="delegate_invitation_id" columnDataType="bigint" startWith="100000"/>
    </changeSet>

    <changeSet id="CREATE-DELEGATE-INVITATION-HSQL-SEQUENCE" author="Camelia Dumitru" dbms="hsqldb">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="delegate_invitation_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="delegate_invitation_seq" startValue="100000"/>
    </changeSet>

    <changeSet id="CREATE-DELEGATE-INVITATION-POSTGRES-PENDING-INDEX" author="Camelia Dumitru" dbms="postgresql">
        <sql>CREATE UNIQUE INDEX delegate_invitation_one_pending ON delegate_invitation (sender_orcid, recipient_orcid) WHERE status = 'PENDING'</sql>
    </changeSet>
</databaseChangeLog>