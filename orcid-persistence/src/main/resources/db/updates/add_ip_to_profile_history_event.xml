<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

    <changeSet id="ADD-IP-TO-PROFILE-HISTORY-EVENT" author="amontenegro" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="profile_history_event" columnName="ip"/>
            </not>
        </preConditions>
        <sql>ALTER TABLE profile_history_event ADD ip inet NULL;</sql>
    </changeSet>

    <changeSet id="ADD-IP-TO-PROFILE-HISTORY-EVENT-HSQLDB" author="amontenegro" dbms="hsqldb">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="profile_history_event" columnName="ip"/>
            </not>
        </preConditions>
        <sql>ALTER TABLE profile_history_event ADD ip VARCHAR(45) NULL;</sql>
    </changeSet>

</databaseChangeLog>